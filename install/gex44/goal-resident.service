# GOAL RESIDENT -- systemd USER unit TEMPLATE (not installed by anything in this repo).
# Contract: vault/specs/gdd-resident-driver.md (Entrance).
#
# Install by hand on GEX44 as the `factory` user:
#   cp install/gex44/goal-resident.service ~/.config/systemd/user/
#   systemctl --user daemon-reload && systemctl --user enable --now goal-resident
#   loginctl enable-linger factory      # keep the user manager alive without a login
#
# PATH is absolute and starts with /home/factory/.local/bin: a non-interactive
# ssh / systemd environment does not read ~/.profile (measured 2026-09-24), so
# uv, codex and claude installed there are otherwise invisible.
[Unit]
Description=GSD-X goal resident (supervised driver of the goal engine)
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=600
StartLimitBurst=10

[Service]
Type=simple
WorkingDirectory=/home/factory/pp
Environment=PATH=/home/factory/.local/bin:/usr/local/bin:/usr/bin:/bin
Environment=PYTHONIOENCODING=utf-8
Environment=GSDX_GOALS_ROOT=/var/lib/kobii-factory/goals
Environment=GSDX_FOUNDER_KEYS=/etc/kobii-factory/founder_keys.json
# Without the witness the anchor reads UNPROTECTED (WITNESS_UNSET), never ENFORCED.
Environment=GSDX_FOUNDER_WITNESS=/var/lib/kobii-factory/witness
Environment=GSDX_QUOTA_DIR=/var/lib/kobii-factory/quota
Environment=GSDX_RESIDENT_STATE=/home/factory/.local/state/gsd-x/resident
# The goal store is shared with factory-judge (group factory, setgid 2770): the
# resident must create files and dirs the relay can append to. Witness modes are
# set explicitly in code and do not depend on this (GEX44 drill, 2026-09-26).
UMask=0007
ExecStart=/usr/bin/python3 -B /home/factory/pp/tools/gsd_x_resident.py run
# After the unit stops (clean exit, crash or `systemctl --user stop`): classify
# every mission and report any process group that outlived the unit.
ExecStopPost=/usr/bin/python3 -B /home/factory/pp/tools/gsd_x_resident.py census
Restart=always
RestartSec=30
# Exit 3 = `run` honoured STOP. Without this, Restart=always relaunches it every
# 30 s until StartLimitBurst fails the unit (found in the wave F rehearsal).
RestartPreventExitStatus=3
# ...and a STOP is an orderly end, not a fault: without this the unit reads
# `failed` after `stop` (measured on GEX44), which monitors would page on.
SuccessExitStatus=3
# Every process the resident started dies with the unit's cgroup.
KillMode=control-group
TimeoutStopSec=120

[Install]
WantedBy=default.target
