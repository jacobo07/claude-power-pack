{
  "_doc": "O0 probes, PREDECLARED (20_O0_METHOD_PREDECLARATION.md). Modes: every_applicable_file (each file matching applies_if must also match met), any_file (some file under glob matches met), no_file (no file under glob matches met). No applicable file -> NOT_APPLICABLE. Every B0 entry not listed here is UNJUDGED in O0, with the class given in 'unjudged'.",
  "probes": [
    {"entry": "web_surface-experience-declared-before-build", "glob": ["DESIGN.md"],
     "mode": "any_file", "met": "(?m)^experience:"},
    {"entry": "web_surface-experience-floors-not-arbitrable",
     "glob": ["*.css", "*.scss", "*.tsx", "*.jsx", "*.ts", "*.js", "*.astro", "*.vue", "*.svelte"],
     "applies_if": "@keyframes|\\btransition\\s*:|framer-motion|\\banimate-|useAnimation|motion\\.div",
     "mode": "any_file", "met": "prefers-reduced-motion|useReducedMotion|motion-reduce"},
    {"entry": "web_surface-repo-private-by-default", "mode": "remote_visibility"},
    {"entry": "persistent_state-monetary-qualifiers-travel-with-amount",
     "glob": ["*.prisma", "*.sql", "*.ex", "*.exs", "*.py"],
     "applies_if": "(?i)\\b(price|amount|total|cost|spend|revenue|fee)(_[a-z]+)?\\s*[:=(]|\\b(price|amount|total|cost|spend|revenue|fee)\\b[^\\n]{0,40}\\b(Decimal|Float|Int|NUMERIC|DECIMAL|:decimal|:float|:integer|Column)",
     "mode": "any_file", "met": "(?i)\\bcurrency\\b"},
    {"entry": "kobiicraft_mode-gui-click-handler-standards", "glob": ["*.java"],
     "applies_if": "InventoryClickEvent", "mode": "every_applicable_file",
     "met": "setCancelled\\(\\s*true\\s*\\)"},
    {"entry": "kobiicraft_mode-inventory-open-close-tick-delay", "glob": ["*.java"],
     "applies_if": "(?s)closeInventory\\(.*openInventory\\(|(?s)openInventory\\(.*closeInventory\\(",
     "mode": "every_applicable_file", "met": "runTaskLater\\("},
    {"entry": "kobiicraft_mode-async-io", "glob": ["*.java"],
     "applies_if": "new FileReader\\(|HttpClient\\.newHttpClient|\\.executeQuery\\(",
     "mode": "every_applicable_file", "met": "runTaskAsynchronously\\("},
    {"entry": "kobiicraft_mode-golden-run-e2e", "glob": ["*golden*run*", "*goldenrun*", "*golden_run*"],
     "mode": "any_file", "met": "."},
    {"entry": "wii_homebrew-no-posix-headers", "glob": ["*.c", "*.h", "*.cpp"],
     "mode": "no_file", "met": "#\\s*include\\s*<(unistd|pthread)\\.h>"},
    {"entry": "wii_homebrew-float-literals-need-f-suffix", "glob": ["*.c", "*.h"],
     "mode": "no_file", "met": "(?<![\\w.\"])\\d+\\.\\d+(?![\\dfFeE.\\w\"])"},
    {"entry": "wii_homebrew-gx-buffers-memalign-dcflush-never-malloc", "glob": ["*.c", "*.cpp"],
     "applies_if": "GX_InitTexObj|GX_SetArray", "mode": "every_applicable_file",
     "met": "memalign\\("}
  ],
  "unjudged": {
    "PROCESS": "happens at build/deploy/claim time; measured by the S6 done-gate ledger, never by repo state",
    "RENDERED": "needs the live surface; measured by CDIO against the real URL",
    "DESIGN": "a code-design property no static regex can decide honestly; needs review"
  },
  "unjudged_class": {
    "web_surface-deploy-http-200-real-domain": "PROCESS",
