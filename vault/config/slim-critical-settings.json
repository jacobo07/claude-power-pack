{
    "hooks":  {
                  "PreToolUse":  [
                                     {
                                         "matcher":  "Bash|PowerShell",
                                         "hooks":  [
                                                       {
                                                           "type":  "command",
                                                           "command":  "C:/Program Files/nodejs/node.exe",
                                                           "args":  [
                                                                        "C:/Users/dev/.claude/hooks/hook-dispatcher.js",
                                                                        "--event=PreToolUse-Bash-chain"
                                                                    ],
                                                           "timeout":  60
                                                       }
                                                   ]
                                     },
                                     {
                                         "matcher":  "Write|Edit|MultiEdit|NotebookEdit",
                                         "hooks":  [
                                                       {
                                                           "type":  "command",
                                                           "command":  "C:/Program Files/nodejs/node.exe",
                                                           "args":  [
                                                                        "C:/Users/dev/.claude/hooks/hook-dispatcher.js",
                                                                        "--event=PreToolUse-Edit-chain"
                                                                    ],
                                                           "timeout":  60
                                                       }
                                                   ]
                                     },
                                     {
                                         "matcher":  "Read|Grep",
                                         "hooks":  [
                                                       {
                                                           "type":  "command",
                                                           "command":  "C:/Program Files/nodejs/node.exe",
                                                           "args":  [
                                                                        "C:/Users/dev/.claude/hooks/hook-dispatcher.js",
                                                                        "--event=PreToolUse-Read-chain"
                                                                    ],
                                                           "timeout":  20
                                                       }
                                                   ]
                                     }
                                 ]
              }
}