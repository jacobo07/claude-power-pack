 "spans": [
  {
   "span_id": "E1",
   "source_id": "S10",
   "start": 819,
   "end": 970,
   "text": "Cloudflare’s measurement shows HTTP/3 holds median page-load time within 5% of baseline at 1% packet loss, versus 30%+ degradation for HTTP/2 over TCP.",
   "sha256": "60d8da72c45c76181aa0270b8fb849c5530e65b4943482021b443c71d0290516"
  },
  {
   "span_id": "E2",
   "source_id": "S10",
   "start": 1069,
   "end": 1182,
   "text": "A fintech API gateway reported a 12% reduction in 99th-percentile latency after enabling QUIC for 30% of traffic.",
   "sha256": "49ee29d7f4a1cba109649e2c5bfee41baf5b2791fc75b8e04a3f3652d8a24e95"
  },
  {
   "span_id": "E3",
   "source_id": "S9",
   "start": 13451,
   "end": 13592,
   "text": "HOL blocking removal rarely moves the needle on real page loads — most pages don't have enough concurrent streams hitting loss simultaneously",
   "sha256": "843298632f921e1e051fc2c0ab7ca884f3c758a25b926faf9df06546e0b6a4af"
  },
  {
   "span_id": "E4",
   "source_id": "S7",
   "start": 10224,
   "end": 10303,
   "text": "QUIC fixes the transport. It does not fix your application’s data dependencies.",
   "sha256": "f8cd98219dc13e1379acbad36c1559a4f91c4eb0c520b39bc9fe3d3b8433f1f4"
  }
 ],
 "claims": [
  {
   "claim_id": "C1",
   "text": "Production deployments show HTTP/3 over QUIC maintains median page load within 5% of baseline at 1% packet loss, while HTTP/2 over TCP degrades 30%+ in identical conditions. Google reports 9–15% video rebuffering reduction on YouTube at 1–3% loss. The improvement comes from QUIC's independent stream retransmission: one lost packet blocks only its stream, not others sharing the connection.",
   "epistemic_in": "OBSERVED",
