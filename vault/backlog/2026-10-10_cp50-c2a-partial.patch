+"""CP50 arm-A executor (recon-factory Phase 7, plan C2a): the decomp Phase 5 free baseline, deterministic, no model.
+
+    python arm_a.py prepare --draw <G0_FREEZE.json> --first A --last B --out <dir> [--python <factory venv python>] [--presets a,b]
+        -> ARM_A_PREPARED job=<dir> capsule=<id> units=<n> functions=<k> no_unit=<id:status,...>
+        -> ARM_A_REFUSED <CODE> <detail>                                          (exit 3; nothing was transported)
+    python arm_a.py records --job <job dir> --draw <G0_FREEZE.json> --first A --last B --out <arm A jsonl> [--prep <json>]
+        -> ARM_A_RECORDS n=<k> out=<path> sha256=<hex>
+        -> ARM_A_REFUSED JOB_NOT_JUDGED ...                                       (nothing is appended)
+
+`prepare` is LOCAL ONLY: it runs the pinned m2c under the factory venv (plain and --valid-syntax) for the ONE cohort,
+writes a candidate units JSONL, builds a cohort capsule through capsule_build (targets_for) and stages one candidate
+job through stage.build. It makes no transport call and no model call; the transport, the wait and the repatriation are a
+later lease. `records` runs after that lease and after `candidate.py judge <job_id>`: it turns the judged ledger rows
+into bench records through bench.run_cohort with an injected executor (bench.py is not edited).
+
+GAP-3: capsules only through capsule_build / custody, returns only through repatriate / candidate.judge. Anything a
+receipt cannot measure is {"absent": reason}, never 0; the three token costs are 0 only because arm A calls no model.
+"""
+import argparse
+import hashlib
+import json
+import os
+import re
+import subprocess
+import sys
+
+HERE = os.path.dirname(os.path.abspath(__file__))
+GEX = os.path.join(HERE, "gex44")
+for _p in (GEX, HERE):
+    if _p not in sys.path:
+        sys.path.insert(0, _p)
+sys.dont_write_bytecode = True
+
+import bench  # noqa: E402  (stdlib-only instrument; cohort and record contracts)
+
+Refused = bench.Refused
+PREP_SCHEMA = "ksr.recon.arm_a_prep/1"
+ARMS_M2C = (("m2c", "m2c", False), ("m2c.valid_syntax", "m2cvs", True))
+ATTEMPTED = ("COMPILE_FAILED", "DIFFED")
+D_ABSENT = {
+    "fresh_floor": "arm A is a local deterministic pipeline: no model context exists to have a floor",
+    "live_frontier": "no model context in arm A",
+    "ctx_mean": "no model context in arm A",
+    "ctx_p95": "no model context in arm A",
+    "marginal_context_rent": "no model context in arm A",
+    "physical_calls": "model-call counts are metered by the control plane, not by this job",
+    "novelty": "not measured by the arm-A job",
+    "cost_to_verified": "needs the control plane's metered tokens, which this job cannot read",
+    "proof_cost": "the receipt times compile+objdiff together; the second oracle's time is not recorded",
+    "rehydrations": "arm A has no session to rehydrate",
+    "family_reuse": "not measured by the arm-A job",
+    "capital_class": "not assigned by the arm-A job",
+}
+
+
+def _absent(reason):
+    return {"absent": reason}
+
+
+def _sha(b):
+    return hashlib.sha256(b).hexdigest()
+
+
+def _jsonl_bytes(rows):
+    return "".join(json.dumps(r, sort_keys=True, ensure_ascii=True) + "\n" for r in rows).encode("utf-8")
+
+
+# ---------------------------------------------------------------- cohort
+def select_cohort(draw, first, last, anchor=bench.DRAW_ANCHOR_SHA):
+    """Exactly one cohort for positions first..last, or a refusal."""
+    entries = bench.load_draw(draw, anchor=anchor)
+    cs = bench.cohorts(entries, first, last)
+    if len(cs) != 1:
+        raise Refused("COHORT_COUNT positions %d-%d make %d cohorts; arm A runs exactly one per process" % (first, last, len(cs)))
+    return cs[0]
+
+
+# ---------------------------------------------------------------- m2c (local, factory venv)
+def find_venv_python(m2c_mod):
+    """First python.exe under the pinned tools root that the producer's own venv_ok accepts, else None."""
+    tools = m2c_mod.TOOLS
+    cands = [v for v in vars(m2c_mod).values() if isinstance(v, str) and v.lower().endswith("python.exe")]
+    for sub in (("venv", "Scripts"), (".venv", "Scripts"), ("m2c-venv", "Scripts")):
+        cands.append(os.path.join(tools, *sub, "python.exe"))
+    base = tools.rstrip("\\/").count(os.sep)
+    for root, dirs, files in os.walk(tools):
+        if root.count(os.sep) - base >= 4:
+            dirs[:] = []
+        if os.path.basename(root).lower() == "scripts" and "python.exe" in files:
+            cands.append(os.path.join(root, "python.exe"))
+    seen = []
+    for c in cands:
+        if c not in seen and os.path.isfile(c) and m2c_mod.venv_ok(c, tools):
+            return c
+        seen.append(c)
+    return None
+
+
+def run_m2c(ids, work, valid_syntax, python, corpus, asm_root):
+    """{id: {"admit": status, "text": c or ""}} from m2c_producer.py run under the factory venv python."""
+    import m2c_producer
+    py = python or find_venv_python(m2c_producer)
+    if not py:
+        raise Refused("M2C_VENV no python under %s passes m2c_producer.venv_ok" % m2c_producer.TOOLS)
+    out = os.path.join(work, "m2c_vs" if valid_syntax else "m2c_plain")
+    os.makedirs(out, exist_ok=True)
+    idf = os.path.join(out, "ids.txt")
+    with open(idf, "w", encoding="utf-8", newline="\n") as fh:
+        fh.write("\n".join(ids) + "\n")
+    cmd = [py, os.path.join(HERE, "m2c_producer.py"), corpus, asm_root, out, "--ids", idf] + (["--valid-syntax"] if valid_syntax else [])
+    r = subprocess.run(cmd, capture_output=True, text=True, timeout=1800)
+    if r.returncode != 0:
+        raise Refused("M2C_REFUSED rc=%d %s" % (r.returncode, (r.stdout + r.stderr).strip()[:400]))
+    res = {}
+    with open(os.path.join(out, "results.tsv"), encoding="utf-8") as fh:
+        for line in fh:
+            parts = line.rstrip("\n").split("\t")
+            if len(parts) < 2:
+                continue
+            cpath = os.path.join(out, "c", parts[0].replace(":", "_") + ".c")
+            text = open(cpath, encoding="utf-8").read() if os.path.isfile(cpath) else ""
+            res[parts[0]] = {"admit": parts[1], "text": text}
+    return res
+
+
+def compose(valid_syntax, text, header):
+    return (header + "\n" + text) if valid_syntax else text
+
+
+# ---------------------------------------------------------------- units
+def _safe(s):
+    return re.sub(r"[^A-Za-z0-9_-]", "_", s)
+
+
+def make_units(cohort, m2c_by_arm, census, presets, header, unit_keys):
+    """(unit rows in candidate.UNIT_KEYS, {id: non-L1 status}). A function whose admit() is not L1 gets no unit."""
+    rows, no_unit = [], {}
+    for _pos, entry in cohort["positions"]:
+        cid = entry["census_id"]
+        c = census[cid]
+        target = "split/obj/" + c["asm_unit"][:-2] + ".o"
+        got_any = False
+        for arm, tag, vs in ARMS_M2C:
+            m = m2c_by_arm[arm].get(cid)
+            status = m["admit"] if m else "NO_M2C_ROW"
+            if status != "L1":
+                no_unit.setdefault(cid, status)
+                continue
+            for pname, flags in sorted(presets.items()):
+                vals = {"unit_id": "A-%s-%s-%s" % (_safe(cid), tag, _safe(pname)), "entity": cid, "symbol": c["name"],
+                        "target_obj": target, "preset": pname, "flags": flags, "flags_delta": None,
+                        "source_text": compose(vs, m["text"], header), "producer": arm, "strategy": "free_baseline",
+                        "family": entry["class"], "variant": pname}
+                miss = [k for k in unit_keys if k not in vals]
+                if miss:
+                    raise Refused("UNIT_KEYS_UNKNOWN candidate.UNIT_KEYS names %s which arm_a does not fill" % miss)
+                rows.append(dict((k, vals[k]) for k in unit_keys))
+                got_any = True
+        if got_any:
+            no_unit.pop(cid, None)
+    return rows, no_unit
+
+
+# ---------------------------------------------------------------- prepare
+def _load_census(ids, path):
+    want, out = set(ids), {}
+    with open(path, "rb") as fh:
+        for raw in fh:
+            if raw.strip():
+                r = json.loads(raw.decode("utf-8"))
+                if r.get("id") in want:
+                    out[r["id"]] = r
+    miss = [i for i in ids if i not in out]
+    if miss:
+        raise Refused("CENSUS_ID_MISSING %s" % miss)
+    return out
+
+
+def _default_capsule(ids):
+    import capsule_build
+    import stage
+    root = stage.RF_GEX44_ROOT
+    lines = []
+    ret = capsule_build.build(out_root=os.path.join(root, "capsules"), trim=("census",), targets_for=list(ids), log=lines.append)
+    cid = None
+    if isinstance(ret, dict):
+        cid = ret.get("capsule_id") or ret.get("id")
+    if not cid:
+        for text in lines + [repr(ret)]:
+            m = re.search(r"CAPSULE=(?:EXISTS\s+)?([0-9A-Za-z][0-9A-Za-z._-]+)", str(text))
+            if m and m.group(1) != "EXISTS":
+                cid = m.group(1)
+                break
+    if not cid:
+        raise Refused("CAPSULE_ID_UNKNOWN capsule_build returned %r and logged %r" % (ret, lines[-3:]))
+    cap = stage.resolve_capsule(cid, root)
+    return {"capsule_id": cap["capsule_id"], "manifest_sha256": cap["manifest_sha256"]}
+
+
+def _default_stage(capsule_id, units_path):
+    import stage
+    return stage.build(mode="candidate", root=stage.RF_GEX44_ROOT, capsule=capsule_id, candidate_units=units_path)
+
+
+def prepare(draw, first, last, out, python=None, presets=None, anchor=bench.DRAW_ANCHOR_SHA, m2c=None, census=None,
+            header=None, capsule_fn=None, stage_fn=None, unit_keys=None):
+    """Everything injectable defaults to the real thing; the drill injects fakes at the same seams."""
+    cohort = select_cohort(draw, first, last, anchor=anchor)
+    ids = [e["census_id"] for _p, e in cohort["positions"]]
+    os.makedirs(out, exist_ok=True)
+    if unit_keys is None:
+        import candidate
+        unit_keys = candidate.UNIT_KEYS
+    if census is None or presets is None or m2c is None or header is None:
+        import capsule_build
+        inp = capsule_build.default_inputs()
+        if census is None:
+            census = _load_census(ids, inp["census"])
+        if presets is None:
+            _base, allp = capsule_build.eval_presets(open(os.path.join(inp["oracle_dir"], "match.py"), "rb").read())
+            presets = dict(allp)
+        if m2c is None:
+            asm_root = os.path.join(inp["split_dir"], "out")
+            m2c = lambda i, vs: run_m2c(i, out, vs, python, inp["l0"], asm_root)  # noqa: E731
+        if header is None:
+            import baseline
+            header = open(baseline.M2C_MACROS, encoding="utf-8").read()
+    by_arm = {arm: m2c(ids, vs) for arm, _tag, vs in ARMS_M2C}
+    rows, no_unit = make_units(cohort, by_arm, census, presets, header, unit_keys)
+    if not rows:
+        raise Refused("NO_UNITS no function of the cohort is L1 in any arm: %s" % no_unit)
+    units_path = os.path.join(out, "arm_a_units.jsonl")
+    blob = _jsonl_bytes(rows)
+    with open(units_path, "wb") as fh:
+        fh.write(blob)
+    cap = (capsule_fn or _default_capsule)(ids)
+    job = (stage_fn or _default_stage)(cap["capsule_id"], units_path)
+    prep = {"schema": PREP_SCHEMA, "first": first, "last": last, "cohort_ids": ids, "job_dir": str(job["dir"]),
+            "capsule_id": cap["capsule_id"], "manifest_sha256": cap.get("manifest_sha256"), "units_sha256": _sha(blob),
+            "units": [{"unit_id": r["unit_id"], "census_id": r["entity"], "arm": r["producer"], "preset": r["preset"]} for r in rows],
+            "no_unit": no_unit}
+    with open(os.path.join(out, "arm_a_prep.json"), "w", encoding="utf-8", newline="\n") as fh:
+        fh.write(json.dumps(prep, sort_keys=True, indent=1) + "\n")
+    return {"job": str(job["dir"]), "capsule": cap["capsule_id"], "manifest_sha256": cap.get("manifest_sha256"),
+            "units": len(rows), "functions": len(set(r["entity"] for r in rows)), "no_unit": no_unit, "units_path": units_path}
+
+
+# ---------------------------------------------------------------- records
+def _find_host(o, depth=0):
+    if isinstance(o, dict):
+        for k in ("host", "hostname", "host_name"):
+            if isinstance(o.get(k), str) and o[k]:
+                return o[k]
+        if depth < 3:
+            for v in o.values():
+                h = _find_host(v, depth + 1)
+                if h:
+                    return h
+    return None
+
+
+def host_plane_of(receipt):
+    h = _find_host(receipt)
+    if not h:
+        return _absent("the receipt names no host")
+    return "GEX44" if "gex44" in h.lower() else h
+
+
+def _rank(row):
+    st = row.get("status")
+    pct = (row.get("objdiff_result") or {}).get("match_percent")
+    return (0 if st == "MATCH_CANDIDATE" else 1 if st == "PARTIAL" else 2, -(pct if isinstance(pct, (int, float)) else -1))
+
+
+def _verdict(best):
+    if best.get("status") == "MATCH_CANDIDATE":
+        return "MATCH"
+    if best.get("status") == "PARTIAL":
+        return "PARTIAL"
+    return best.get("miss_class") or best.get("status") or "UNKNOWN"
+
+
+def _all_numeric(vals):
+    return bool(vals) and all(isinstance(v, (int, float)) and not isinstance(v, bool) for v in vals)
+
+
+def executor_from_judged(rows, receipt, no_unit=None):
+    """Executor for bench.run_cohort: one body per function from its judged ledger rows and the receipt's timings."""
+    by_ent = {}
+    for r in rows:
+        by_ent.setdefault(r.get("entity"), []).append(r)
+    rec_units = dict((u.get("unit_id"), u) for u in ((receipt.get("results") or {}).get("units") or []) if isinstance(u, dict))
+    plane = host_plane_of(receipt)
+    no_unit = no_unit or {}
+    d_base = dict((k, _absent(v)) for k, v in D_ABSENT.items())
+    d_base["deterministic_vs_cognitive"] = "deterministic"
+    zero_tokens = {"local_tokens": 0, "paid_tokens": 0, "new_cognition_tokens": 0}  # arm A calls no model
+
+    def executor(arm, entry, pos, cohort_k):
+        if arm != "A":
+            raise Refused("ARM_UNSUPPORTED arm_a.py executes arm A only, not %r" % (arm,))
+        cid = entry["census_id"]
+        rs = by_ent.get(cid)
+        if not rs:
+            if cid not in no_unit:
+                raise Refused("JOB_NOT_JUDGED %s has neither a judged row nor a recorded non-L1 status" % cid)
+            cost = {"wall_s": _absent("no unit of this function was compiled"), "compiles": 0}
+            cost.update(zero_tokens)
+            return {"host_plane": _absent("no unit of this function was compiled"), "verdict": no_unit[cid],
+                    "verified": False, "cost": cost, "amendment_d": dict(d_base)}
+        best = sorted(rs, key=_rank)[0]
+        ru = [rec_units.get(r.get("unit_id")) for r in rs]
+        walls = [u.get("wall_s") if u else None for u in ru]
+        wall = round(sum(walls), 3) if _all_numeric(walls) else _absent("the receipt has no wall_s for %d of %d units" % (sum(1 for w in walls if not _all_numeric([w])), len(rs)))
+        stats = [u.get("runner_status") if u else None for u in ru]
+        compiles = sum(1 for s in stats if s in ATTEMPTED) if all(stats) else _absent("the receipt lacks a row for some unit")
+        verified = (best.get("status") == "MATCH_CANDIDATE" and (best.get("objdiff_result") or {}).get("match_percent") == 100.0
+                    and (best.get("oracle2") or {}).get("verdict") == "MATCH")
+        cost = {"wall_s": wall, "compiles": compiles}
+        cost.update(zero_tokens)
+        return {"host_plane": plane, "verdict": _verdict(best), "verified": bool(verified), "cost": cost,
+                "amendment_d": dict(d_base)}
+
+    return executor
+
+
+def load_judged(job_dir, ledger_path=None, returns_root=None):
+    """(ledger rows of this job, receipt dict). JOB_NOT_JUDGED when the judge has written no row."""
+    rec_path = os.path.join(job_dir, "job_record.json")
+    job_id = json.load(open(rec_path, encoding="utf-8")).get("job_id") if os.path.isfile(rec_path) else None
+    if not job_id:
+        raise Refused("JOB_NOT_JUDGED %s carries no job_id (the job was never queued)" % job_dir)
+    import candidate_ledger
+    import reproduce
+    import stage
+    lp = ledger_path or str(candidate_ledger.default_path())
+    rows = [r for r in (candidate_ledger.stage.chain_rows(lp) if os.path.isfile(lp) else []) if r.get("job_id") == job_id]
+    if not rows:
+        raise Refused("JOB_NOT_JUDGED the candidate ledger has no row for job %s; run candidate.py judge first" % job_id)
+    tree = os.path.join(returns_root or str(stage.gex44_root() / "returns"), job_id)
+    receipt = json.load(open(os.path.join(str(reproduce.out_dir_of(tree)), "receipt.json"), encoding="utf-8"))
+    return rows, receipt
+
+
+def records(job_dir, draw, first, last, out, prep_path=None, ledger_path=None, returns_root=None, anchor=bench.DRAW_ANCHOR_SHA):
+    cohort = select_cohort(draw, first, last, anchor=anchor)
+    rows, receipt = load_judged(job_dir, ledger_path, returns_root)
+    prep_path = prep_path or os.path.join(os.path.dirname(os.path.abspath(out)), "arm_a_prep.json")
+    no_unit = json.load(open(prep_path, encoding="utf-8")).get("no_unit", {}) if os.path.isfile(prep_path) else {}
+    recs = bench.run_cohort("A", cohort, executor=executor_from_judged(rows, receipt, no_unit), out=out)
+    return recs
+
+
+def main(argv=None):
+    ap = argparse.ArgumentParser()
+    sub = ap.add_subparsers(dest="verb", required=True)
+    p = sub.add_parser("prepare")
+    r = sub.add_parser("records")
+    for s in (p, r):
+        s.add_argument("--draw", required=True)
+        s.add_argument("--first", type=int, required=True)
+        s.add_argument("--last", type=int, required=True)
+        s.add_argument("--out", required=True)
+    p.add_argument("--python")
+    p.add_argument("--presets")
+    r.add_argument("--job", required=True)
+    r.add_argument("--prep")
+    a = ap.parse_args(argv)
+    try:
+        if a.verb == "prepare":
+            presets = None
+            if a.presets:
+                import capsule_build
+                inp = capsule_build.default_inputs()
+                _b, allp = capsule_build.eval_presets(open(os.path.join(inp["oracle_dir"], "match.py"), "rb").read())
+                presets = dict((k, allp[k]) for k in a.presets.split(","))
+            res = prepare(a.draw, a.first, a.last, a.out, python=a.python, presets=presets)
+            print("ARM_A_PREPARED job=%s capsule=%s units=%d functions=%d no_unit=%s" % (
+                res["job"], res["capsule"], res["units"], res["functions"],
+                ",".join("%s:%s" % kv for kv in sorted(res["no_unit"].items())) or "none"))
+            print("ARM_A_FACTS manifest_sha256=%s units_path=%s" % (res["manifest_sha256"], res["units_path"]))
+            return 0
+        recs = records(a.job, a.draw, a.first, a.last, a.out, prep_path=a.prep)
+        print("ARM_A_RECORDS n=%d out=%s sha256=%s" % (len(recs), a.out, _sha(open(a.out, "rb").read())))
+        return 0
+    except Exception as e:  # a refusal is a result: print its code verbatim
+        print("ARM_A_REFUSED %s: %s" % (type(e).__name__, e))
+        return 3
+
+
+if __name__ == "__main__":
+    sys.exit(main())
