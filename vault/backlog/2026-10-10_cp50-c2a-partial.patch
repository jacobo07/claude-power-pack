+"""Drill for arm_a.py. Every gate has a red control; everything runs in temp dirs (no real ledger, no RF jobs dir).
+The one real-data gate (V-ARMA-CAPSULE-IDENTITY) builds capsules from the read-only factory inputs into a temp root."""
+import json
+import os
+import re
+import sys
+import tempfile
+
+HERE = os.path.dirname(os.path.abspath(__file__))
+for _p in (os.path.join(HERE, "gex44"), HERE):
+    if _p not in sys.path:
+        sys.path.insert(0, _p)
+sys.dont_write_bytecode = True
+
+import arm_a  # noqa: E402
+import bench  # noqa: E402
+
+PASSES, TOTAL = [0], [0]
+REAL_ID = "main:80426354"
+
+
+def gate(name, fn):
+    TOTAL[0] += 1
+    try:
+        ev = fn()
+        PASSES[0] += 1
+        print("PASS %s %s" % (name, ev))
+    except Exception as e:  # noqa: BLE001
+        print("FAIL %s %s: %s" % (name, type(e).__name__, str(e)[:300]))
+
+
+def expect_refused(code, fn):
+    try:
+        fn()
+    except Exception as e:  # noqa: BLE001
+        if code not in str(e) and code != getattr(e, "code", None):
+            raise AssertionError("expected %s, got %s: %s" % (code, type(e).__name__, e))
+        return
+    raise AssertionError("expected refusal %s, nothing raised" % code)
+
+
+def synth_draw(tmp, n=20):
+    ents = [{"census_id": "main:%08X" % (0x80000000 + i * 0x40), "class": "CXX", "size_bucket": "Q1", "bgroup": "NONE"} for i in range(n)]
+    path = os.path.join(tmp, "G0_FREEZE.json")
+    with open(path, "w", encoding="utf-8") as fh:
+        json.dump({"draw": {"ids": ents, "sorted_id_sha256": bench._id_sha([e["census_id"] for e in ents])}}, fh)
+    return path, ents
+
+
+def fixture_prepare(tmp, statuses):
+    """prepare() with every seam faked; returns (result, units rows, census, presets, ents)."""
+    draw, ents = synth_draw(tmp)
+    ids = [e["census_id"] for e in ents[:5]]
+    census = dict((i, {"id": i, "name": "fn_%d" % k, "asm_unit": "u%d.s" % k}) for k, i in enumerate(ids))
+    try:
+        import capsule_build
+        import candidate  # noqa: F401
+        inp = capsule_build.default_inputs()
+        _b, allp = capsule_build.eval_presets(open(os.path.join(inp["oracle_dir"], "match.py"), "rb").read())
+        presets = {sorted(allp)[0]: allp[sorted(allp)[0]]}
+    except Exception:  # noqa: BLE001
+        presets = {"p1": "-O4,p -proc gekko"}
+
+    def m2c(ids_, vs):
+        return dict((i, {"admit": statuses.get(i, "L1"), "text": "int f%d(void) { return %d; }\n" % (k, k + (100 if vs else 0))})
+                    for k, i in enumerate(ids_))
+
+    out = os.path.join(tmp, "out")
+    res = arm_a.prepare(draw, 1, 5, out, anchor=None, m2c=m2c, census=census, presets=presets, header="#define M2C_X 1\n",
+                        capsule_fn=lambda i: {"capsule_id": "cap-test", "manifest_sha256": "0" * 64},
+                        stage_fn=lambda cid, up: {"dir": os.path.join(tmp, "job")})
+    import candidate
+    rows, _sha = candidate.load_units(res["units_path"])
+    return res, rows, census, presets, ents
+
+
+def g_cohort():
+    with tempfile.TemporaryDirectory() as tmp:
+        draw, _e = synth_draw(tmp)
+        c = arm_a.select_cohort(draw, 1, 5, anchor=None)
+        assert c["first"] == 1 and c["last"] == 5 and len(c["positions"]) == 5, c
+        expect_refused("COHORT_COUNT", lambda: arm_a.select_cohort(draw, 1, 15, anchor=None))
+        expect_refused("DRAW_ANCHOR", lambda: arm_a.select_cohort(draw, 1, 5))  # control: the real anchor rejects a synthetic draw
+    return "1-5 -> one cohort of 5; 1-15 -> COHORT_COUNT; synthetic draw vs real anchor -> DRAW_ANCHOR"
+
+
+def g_units():
+    import candidate
+    with tempfile.TemporaryDirectory() as tmp:
+        res, rows, census, presets, _e = fixture_prepare(tmp, {})
+        files = dict(("split/obj/u%d.o" % k, {}) for k in range(5))
+        targets = [{"entity": i, "symbol": c["name"], "target_obj": "split/obj/" + c["asm_unit"][:-2] + ".o"} for i, c in census.items()]
+        manifest = {"files": files, "presets": presets, "targets": targets}
+        built = candidate.build_units(rows, manifest)
+        assert len(built) == len(rows) == 5 * 2 * len(presets), (len(built), len(rows))
+        assert set(r["producer"] for r in rows) == {"m2c", "m2c.valid_syntax"}
+        bad = [dict(rows[0], target_obj="split/obj/nope.o")] + rows[1:]
+        expect_refused("TARGET_NOT_IN_CAPSULE", lambda: candidate.build_units(bad, manifest))
+        short = dict(manifest, targets=targets[1:])
+        expect_refused("TARGET_NOT_IN_CAPSULE", lambda: candidate.build_units(rows, short))
+    return "%d units pass build_units; unknown object and non-target entity -> TARGET_NOT_IN_CAPSULE" % len(built)
+
+
+def g_nonl1():
+    with tempfile.TemporaryDirectory() as tmp:
+        draw, ents = synth_draw(tmp)
+        bad_id = ents[2]["census_id"]
+        res, rows, census, presets, _e = fixture_prepare(tmp, {bad_id: "M2C_FAILED"})
+        assert bad_id not in set(r["entity"] for r in rows), "a non-L1 function got a unit"
+        assert res["no_unit"] == {bad_id: "M2C_FAILED"}, res["no_unit"]
+        assert res["functions"] == 4
+        # control: with every function L1 the same id does get units
+        res2, rows2, *_ = fixture_prepare(os.path.join(tmp, "ctl") if os.makedirs(os.path.join(tmp, "ctl")) is None else tmp, {})
+        assert bad_id in set(r["entity"] for r in rows2) and res2["no_unit"] == {}
+        prep = json.load(open(os.path.join(tmp, "out", "arm_a_prep.json")))
+        ex = arm_a.executor_from_judged([], {"host": "kobicraft-gex44", "results": {"units": []}}, prep["no_unit"])
+        body = ex("A", ents[2], 3, 1)
+        assert body["verdict"] == "M2C_FAILED" and body["verified"] is False
+    return "M2C_FAILED function -> no unit, record verdict M2C_FAILED; control all-L1 -> units present"
+
+
+def g_capsule_identity():
+    import capsule_build
+    from pathlib import Path
+    fixed = "2026-10-10T00:00:00Z"
+    with tempfile.TemporaryDirectory() as tmp:
+        root = os.path.join(tmp, "caps")
+
+        def dirs():
+            return sorted(d for d in os.listdir(root) if not d.startswith(".")) if os.path.isdir(root) else []
+
+        def mbytes(d):
+            return (Path(root) / d / "MANIFEST.json").read_bytes()
+
+        capsule_build.build(out_root=root, trim=("census",), created_at=fixed, log=lambda *_a: None)
+        a = dirs()
+        assert len(a) == 1, a
+        base_bytes = mbytes(a[0])
+        capsule_build.build(out_root=root, trim=("census",), created_at=fixed, log=lambda *_a: None, targets_for=None)
+        assert dirs() == a and mbytes(a[0]) == base_bytes, "targets_for=None changed the capsule"
+        capsule_build.build(out_root=root, trim=("census",), created_at=fixed, log=lambda *_a: None, targets_for=[REAL_ID])
+        b = [d for d in dirs() if d not in a]
+        assert len(b) == 1, "targets_for=[id] produced no new capsule: %s" % dirs()
+        man_b = mbytes(b[0])
+        assert man_b != base_bytes, "control: the comparison cannot tell the two manifests apart"
+        m = json.loads(man_b.decode("utf-8"))
+        assert any(t.get("entity") == REAL_ID for t in (m.get("targets") or [])), "target %s absent from manifest" % REAL_ID
+    return "None == omitted (%d bytes); targets_for=[%s] -> new capsule with that target" % (len(base_bytes), REAL_ID)
+
+
+def judged_fixture(ents):
+    ids = [e["census_id"] for e in ents[:5]]
+
+    def row(k, uid, status, miss, pct, o2):
+        return {"job_id": "ksrmb-x", "unit_id": uid, "entity": ids[k], "status": status, "miss_class": miss,
+                "objdiff_result": {"match_percent": pct}, "oracle2": {"verdict": o2}}
+
+    rows = [row(0, "A-0-p", "PARTIAL", "codegen_diff", 80.0, "NOT_MATCH"), row(0, "A-0-m", "MATCH_CANDIDATE", None, 100.0, "MATCH"),
+            row(1, "A-1-p", "PARTIAL", "codegen_diff", 55.0, "NOT_MATCH"),
+            row(2, "A-2-b", "BLOCKED_COMPILE", "compile_error", None, None),
+            row(4, "A-4-m", "MATCH_CANDIDATE", None, 100.0, "NOT_MATCH")]
+    units = [{"unit_id": u, "wall_s": w, "runner_status": s} for u, w, s in
+             (("A-0-p", 1.5, "DIFFED"), ("A-0-m", 2.0, "DIFFED"), ("A-1-p", 1.0, "DIFFED"), ("A-2-b", 0.5, "COMPILE_FAILED"),
+              ("A-4-m", 1.25, "DIFFED"))]
+    receipt = {"host": "kobicraft-gex44", "results": {"units": units}}
+    return ids, rows, receipt, {ids[3]: "M2C_FAILED"}
+
+
+def g_records():
+    with tempfile.TemporaryDirectory() as tmp:
+        draw, ents = synth_draw(tmp)
+        ids, rows, receipt, nu = judged_fixture(ents)
+        cohort = arm_a.select_cohort(draw, 1, 5, anchor=None)
+        out = os.path.join(tmp, "armA.jsonl")
+        recs = bench.run_cohort("A", cohort, executor=arm_a.executor_from_judged(rows, receipt, nu), out=out)
+        assert len(recs) == 5
+        for r in recs:
+            bench.validate_record(r)
+        by = dict((r["census_id"], r) for r in recs)
+        assert by[ids[0]]["verdict"] == "MATCH" and by[ids[0]]["verified"] is True, by[ids[0]]  # MATCH row listed after PARTIAL
+        assert by[ids[0]]["cost"]["wall_s"] == 3.5 and by[ids[0]]["cost"]["compiles"] == 2
+        assert by[ids[1]]["verdict"] == "PARTIAL" and by[ids[1]]["verified"] is False
+        assert by[ids[2]]["verdict"] == "compile_error"
+        assert by[ids[3]]["verdict"] == "M2C_FAILED"
+        assert by[ids[4]]["verdict"] == "MATCH" and by[ids[4]]["verified"] is False, "one oracle alone must not verify"
+        assert by[ids[0]]["host_plane"] == "GEX44"
+        # control: rank, not row order
+        assert arm_a._rank(rows[1]) < arm_a._rank(rows[0])
+    return "5 records validate; MATCH over PARTIAL regardless of row order; one-oracle MATCH not verified; plane GEX44"
+
+
+def g_unjudged():
+    import candidate_ledger  # noqa: F401
+    with tempfile.TemporaryDirectory() as tmp:
+        draw, ents = synth_draw(tmp)
+        job = os.path.join(tmp, "job")
+        os.makedirs(job)
+        with open(os.path.join(job, "job_record.json"), "w", encoding="utf-8") as fh:
+            json.dump({"job_id": "ksrmb-unjudged"}, fh)
+        out = os.path.join(tmp, "armA.jsonl")
+        expect_refused("JOB_NOT_JUDGED", lambda: arm_a.records(job, draw, 1, 5, out, ledger_path=os.path.join(tmp, "no_ledger.jsonl"),
+                                                                returns_root=tmp, anchor=None))
+        assert not os.path.exists(out), "a refusal appended something"
+        os.remove(os.path.join(job, "job_record.json"))
+        expect_refused("JOB_NOT_JUDGED", lambda: arm_a.load_judged(job))  # control: a never-queued job refuses too
+        ids, rows, receipt, nu = judged_fixture(ents)
+        ex = arm_a.executor_from_judged(rows[:2], receipt, {})  # partial judging: functions 2..5 uncovered
+        expect_refused("JOB_NOT_JUDGED", lambda: ex("A", ents[2], 3, 1))
+    return "no judge rows -> JOB_NOT_JUDGED and no file; never-queued job and uncovered function refuse"
+
+
+def g_nozero():
+    with tempfile.TemporaryDirectory() as tmp:
+        draw, ents = synth_draw(tmp)
+        ids, rows, receipt, nu = judged_fixture(ents)
+        receipt["results"]["units"][2]["wall_s"] = None  # A-1-p lost its timing
+        body = arm_a.executor_from_judged(rows, receipt, nu)("A", ents[1], 2, 1)
+        w = body["cost"]["wall_s"]
+        assert isinstance(w, dict) and bench._is_absent(w) and w["absent"], "unmeasured wall_s became %r" % (w,)
+        ad = body["amendment_d"]
+        for k in bench.AMEND_D_KEYS:
+            if k == "deterministic_vs_cognitive":
+                assert ad[k] == "deterministic"
+            else:
+                assert isinstance(ad[k], dict) and bench._is_absent(ad[k]) and ad[k]["absent"], "%s = %r" % (k, ad[k])
+        assert body["cost"]["local_tokens"] == body["cost"]["paid_tokens"] == body["cost"]["new_cognition_tokens"] == 0
+        nohost = arm_a.executor_from_judged(rows, {"results": receipt["results"]}, nu)("A", ents[0], 1, 1)
+        assert bench._is_absent(nohost["host_plane"]), "a receipt with no host must give absent, got %r" % (nohost["host_plane"],)
+    return "unmeasured wall_s, host and every (d) field are absent-with-reason; only the token costs are 0 (no model call)"
+
+
+FORBIDDEN = re.compile(r"\bstage\s*\.\s*send\b|\bssh\b|\bscp\b", re.I)
+
+
+def g_nosend():
+    src = open(os.path.join(HERE, "arm_a.py"), encoding="utf-8").read()
+    hit = FORBIDDEN.search(src)
+    assert hit is None, "arm_a.py contains a transport call: %r" % hit.group(0)
+    assert FORBIDDEN.search("stage.send(tag)") and FORBIDDEN.search("subprocess.run(['ssh', h])"), "control: detector is blind"
+    return "no stage.send / transport token in arm_a.py (%d bytes); detector fires on both control strings" % len(src)
+
+
+def main():
+    for name, fn in (("V-ARMA-COHORT", g_cohort), ("V-ARMA-UNITS", g_units), ("V-ARMA-NONL1", g_nonl1),
+                     ("V-ARMA-CAPSULE-IDENTITY", g_capsule_identity), ("V-ARMA-RECORDS", g_records),
+                     ("V-ARMA-UNJUDGED", g_unjudged), ("V-ARMA-NOZERO", g_nozero), ("V-ARMA-NOSEND", g_nosend)):
+        gate(name, fn)
+    print("ARM_A_DRILL=%d/%d" % (PASSES[0], TOTAL[0]))
+    return 0 if PASSES[0] == TOTAL[0] else 1
+
+
+if __name__ == "__main__":
+    sys.exit(main())
