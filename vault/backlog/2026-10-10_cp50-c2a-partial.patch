@@ -393,8 +393,39 @@ def _project(files, meta):
     raise CapsuleRefused("PROJECTION_UNSTABLE", "tar_projected_bytes did not settle")
 
 
+def resolve_targets_for(inp: dict, idx: dict, obj_dir: str, ids) -> list:
+    """The target record of each given census id (a cohort whose targets are not donors), sorted by entity. Same
+    refusals as resolve_targets: TARGET_COUNT (repeated id, or no census row), ASM_UNIT_MISMATCH, TARGET_OBJ_MISSING."""
+    want = list(ids)
+    if not want or len(set(want)) != len(want):
+        raise CapsuleRefused("TARGET_COUNT", "targets_for must be a non-empty list of distinct census ids: %r" % (want[:5],))
+    rows = {}
+    with open(inp["census"], "rb") as f:
+        for raw in f:
+            if raw.strip():
+                r = json.loads(raw.decode("utf-8"))
+                if r.get("id") in want:
+                    rows[r["id"]] = r
+    missing = [i for i in want if i not in rows]
+    if missing:
+        raise CapsuleRefused("TARGET_COUNT", "no census row for %s" % missing[:5])
+    out = []
+    for i in sorted(want):
+        r = rows[i]
+        found = idx.get(r["name"])
+        if not found or found != [r.get("asm_unit")]:
+            raise CapsuleRefused("ASM_UNIT_MISMATCH", "target %s (%s): .fn index %s, census asm_unit %s"
+                                 % (r["id"], r["name"], found, r.get("asm_unit")))
+        obj_name = found[0][:-2] + ".o"
+        if not os.path.isfile(os.path.join(obj_dir, obj_name)):
+            raise CapsuleRefused("TARGET_OBJ_MISSING", "target %s: %s" % (r["id"], os.path.join(obj_dir, obj_name)))
+        out.append({"entity": r["id"], "symbol": r["name"], "asm_unit": found[0], "target_obj": "split/obj/" + obj_name,
+                    "family": r.get("primary"), "shape_id": r.get("shape_id"), "template": "COHORT_TARGET"})
+    return out
+
+
 def build(out_root=None, ceiling_bytes=custody.CAPSULE_CEILING_BYTES, trim=(), set_current=False, inputs=None,
-          created_at=None, log=print, targets_from_donors=False):
