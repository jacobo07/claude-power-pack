diff --git a/tools/wros/binary/decomp/gex44/tennis_context.h b/tools/wros/binary/decomp/gex44/tennis_context.h
new file mode 100644
index 0000000..e21d037
--- /dev/null
+++ b/tools/wros/binary/decomp/gex44/tennis_context.h
@@ -0,0 +1,134 @@
+/* tennis_context.h -- m2c --context type context for the Tennis W5a draw (12 functions, MEASURE.md W5a; WU-W11).
+ * Source: the DTK disassembly of SportsPackEP.dol (wst_tennis/step0/split_sports/out/asm), read with
+ * trf/evidence/w11/dumpasm.py. Every named struct member cites the load/store displacement it comes from as
+ * `+0xNN` (test_tennis_context.py checks the cited offset against m2c's own layout of the member). Names are
+ * offset-derived (f_XX / m_XX): the asm gives layout, not names. Pads place each member at exactly its offset.
+ * Prototypes cite the argument registers the asm reads and the value it leaves in r3. Nothing here is m2c output.
+ * Pure C declarations, valid as C and C++. The prelude is the Dolphin SDK base types (dolphin/types.h), ported
+ * from CP50 arm_a.M2C_TYPES: a unit built from this header carries it once, never twice. */
+typedef signed char s8;
+typedef signed short s16;
+typedef signed long s32;
+typedef signed long long s64;
+typedef unsigned char u8;
+typedef unsigned short u16;
+typedef unsigned long u32;
+typedef unsigned long long u64;
+typedef float f32;
+typedef double f64;
+
+/* ---- fn_8022F90C: `add r3,r3,r4; lbz r3,0x2a(r3)` -- byte at +0x2A of the object at arg0 + arg1 (arg1 unscaled:
+ *      no slwi/mulli before the add, so a byte offset or a byte-array index) ---- */
+typedef struct Obj8022F90C {
+    u8 pad_00[0x2A];
+    u8 f_2A; /* +0x2A lbz r3,0x2a(r3) */
+} Obj8022F90C;
+u8 fn_8022F90C(Obj8022F90C *arg0, s32 arg1);
+
+/* ---- fn_80203FEC: `slwi r0,r4,3; lbzx r3,r3,r0` -- first byte of an 8-byte element arg0[arg1] ---- */
+typedef struct Elem80203FEC {
+    u8 f_00;        /* +0x00 lbzx r3,r3,r0 (r0 = r4 << 3) */
+    u8 pad_01[7];   /* element stride 8 = slwi r0,r4,3 */
+} Elem80203FEC;
+u8 fn_80203FEC(Elem80203FEC *arg0, s32 arg1);
+
+/* ---- fn_8020711C: `lwz r3,0x1c(r3); subi r0,r3,2; cntlzw; srwi 5` = (f_1C == 2) ---- */
+typedef struct Obj8020711C {
+    u8 pad_00[0x1C];
+    s32 f_1C; /* +0x1C lwz r3,0x1c(r3) */
+} Obj8020711C;
+s32 fn_8020711C(Obj8020711C *arg0);
+
+/* ---- fn_8021EAA8: `slwi r4,r4,4; slwi r0,r5,2; add; add; lwz r3,0x14(r3)` -- rows of 0x10 bytes, s32 cells ---- */
+typedef struct Row8021EAA8 {
+    s32 f_00[4]; /* +0x00 cell stride 4 = slwi r0,r5,2; row stride 0x10 = slwi r4,r4,4 */
+} Row8021EAA8;
+typedef struct Obj8021EAA8 {
+    u8 pad_00[0x14];
+    Row8021EAA8 f_14[1]; /* +0x14 lwz r3,0x14(r3) after the row/cell adds */
+} Obj8021EAA8;
+s32 fn_8021EAA8(Obj8021EAA8 *arg0, s32 arg1, s32 arg2);
+
+/* ---- fn_8020CC14: `lwz r0,0x0(r3)`, `lwz r0,0x8(r3)`, `lbz r0,0x10(r3)`; r4 compared with cmpw ---- */
+typedef struct Obj8020CC14 {
+    s32 f_00;      /* +0x00 lwz r0,0x0(r3) */
+    u8 pad_04[4];
+    s32 f_08;      /* +0x08 lwz r0,0x8(r3) */
+    u8 pad_0C[4];
+    u8 f_10;       /* +0x10 lbz r0,0x10(r3) */
+} Obj8020CC14;
+s32 fn_8020CC14(Obj8020CC14 *arg0, s32 arg1);
+
+/* ---- fn_80241018: `lwz r0,0x0/0x4/0x8(r3)`, each `cmpwi r0,0x3` ---- */
+typedef struct Obj80241018 {
+    s32 f_00; /* +0x00 lwz r0,0x0(r3) */
+    s32 f_04; /* +0x04 lwz r0,0x4(r3) */
+    s32 f_08; /* +0x08 lwz r0,0x8(r3) */
+} Obj80241018;
+s32 fn_80241018(Obj80241018 *arg0);
+
+/* ---- fn_801BD194: r3 passed through, `li r4,0x8; li r5,0x0; b fn_801BD1A0` (tail call) ----
+ * fn_801BD1A0 saves r3/r4/r5 (`mr r28,r3; mr r29,r4; mr r27,r5`), stores `stw r30,0x8(r28)` (r3 is a pointer)
+ * and returns `mr r3,r31` (r31 starts `li r31,0x0`): s32 (void *, s32, s32). */
+s32 fn_801BD1A0(void *arg0, s32 arg1, s32 arg2);
+s32 fn_801BD194(void *arg0);
+
+/* ---- shared callees of fn_80257978 / fn_8025C600 / fn_8022621C ----
+ * fn_800B4548: reads only r3 (`mr r28,r3`, then `bl fn_801063E0`); callers ignore r3 after it.
+ * fn_800BC298, fn_801F331C: read r3 and r4 (`cmpwi r3,0x0`, `cmpwi r4,0x0` / `mr r31,r4`), return r3 unchanged
+ * (`mr r31,r3 ... mr r3,r31` / `mr r30,r3 ... mr r3,r30`). */
+void fn_800B4548(s32 arg0);
+s32 fn_800BC298(s32 arg0, s32 arg1);
+s32 fn_801F331C(s32 arg0, s32 arg1);
+
+/* ---- fn_80257978: `cmpwi r3,0; cmpwi r4,0; ble; bl fn_800B4548` with r3 = arg0; returns `mr r3,r31` = arg0 ---- */
+s32 fn_80257978(s32 arg0, s32 arg1);
+
+/* ---- fn_8025C600: `li r4,0x0; bl fn_801F331C` (r3 = arg0), then `mr r3,r30; bl fn_800B4548`; returns arg0 ---- */
+s32 fn_8025C600(s32 arg0, s32 arg1);
+
+/* ---- fn_8022621C: `li r4,0x0; bl fn_800BC298` (r3 = arg0), then `mr r3,r30; bl fn_800B4548`; returns arg0 ---- */
+s32 fn_8022621C(s32 arg0, s32 arg1);
+
+/* ---- fn_80254440: `mr r31,r3`; three virtual calls `lwz r3,N(r31); lwz r12,0x0(r3); lwz r12,M(r12); bctrl`
+ *      with this = the loaded r3, and `lwz r3,0x14(r31); bl fn_80259A8C` ---- */
+struct Sub80254440;
+typedef struct Vt80254440 {
+    u8 pad_00[0x10];
+    void (*m_10)(struct Sub80254440 *); /* +0x10 lwz r12,0x10(r12) (via f_08 and f_0C) */
+    void (*m_14)(struct Sub80254440 *); /* +0x14 lwz r12,0x14(r12) (via f_10) */
+} Vt80254440;
+typedef struct Sub80254440 {
+    Vt80254440 *vt; /* +0x00 lwz r12,0x0(r3) */
+} Sub80254440;
+typedef struct Obj80254440 {
+    u8 pad_00[0x8];
+    Sub80254440 *f_08; /* +0x08 lwz r3,0x8(r31) */
+    Sub80254440 *f_0C; /* +0x0C lwz r3,0xc(r31) */
+    Sub80254440 *f_10; /* +0x10 lwz r3,0x10(r3) */
+    void *f_14;        /* +0x14 lwz r3,0x14(r31) -> fn_80259A8C */
+} Obj80254440;
+/* fn_80259A8C: `mr r31,r3`, then `lwz r0,0x8(r3)`, `stfs f2,0x68(r3)`: one pointer argument; r3 unused by caller */
+void fn_80259A8C(void *arg0);
+void fn_80254440(Obj80254440 *arg0);
+
+/* ---- fn_80252F34: `lwz r4,0xc8(r3)`; else `lwz r4,0xc4(r3); lwz r5,0x8(r4); lwz r0,0xc(r4); cmplw r5,r0`
+ *      (begin == end -> 0, else `lwz r4,0x0(r5)`); else `lwz r4,0xcc(r3)`; result `addi r3,r4,0x8`, or
+ *      `lis/addi lbl_804F97B8` when all three are 0 ---- */
+typedef struct Item80252F34 {
+    u8 pad_00[0x8];
+    u8 f_08[1]; /* +0x08 addi r3,r4,0x8 (address returned) */
+} Item80252F34;
+typedef struct Vec80252F34 {
+    u8 pad_00[0x8];
+    Item80252F34 **f_08; /* +0x08 lwz r5,0x8(r4) (begin; `lwz r4,0x0(r5)` = first element) */
+    Item80252F34 **f_0C; /* +0x0C lwz r0,0xc(r4) (end; cmplw r5,r0) */
+} Vec80252F34;
+typedef struct Obj80252F34 {
+    u8 pad_00[0xC4];
+    Vec80252F34 *f_C4;  /* +0xC4 lwz r4,0xc4(r3) */
+    Item80252F34 *f_C8; /* +0xC8 lwz r4,0xc8(r3) */
+    Item80252F34 *f_CC; /* +0xCC lwz r4,0xcc(r3) */
+} Obj80252F34;
+extern u8 lbl_804F97B8[];
+u8 *fn_80252F34(Obj80252F34 *arg0);
diff --git a/tools/wros/binary/decomp/gex44/tennis_context.py b/tools/wros/binary/decomp/gex44/tennis_context.py
new file mode 100644
index 0000000..b10fe77
--- /dev/null
+++ b/tools/wros/binary/decomp/gex44/tennis_context.py
@@ -0,0 +1,106 @@
+"""Tennis m2c type context (WU-W11): the header path, the ported M2C_TYPES prelude, unit composition, and the
+citation check that every struct member's cited asm offset is where m2c's own layout puts it.
+
+    <venv>/python tennis_context.py check      -> TENNIS_CONTEXT_OK members=<n>   |  TENNIS_CONTEXT_BAD <finding> (exit 1)
+
+tennis_context.h starts with the prelude (Dolphin SDK base types, CP50 arm_a.M2C_TYPES, byte-identical), so a unit
+built from it is compose(text): header + m2c text, the prelude exactly once (C89/C99 refuse a repeated typedef).
+check_citations is pure (text in, findings out); layout_of runs the pinned m2c's parser and needs the factory venv.
+"""
+import os
+import re
+import sys
+
+HERE = os.path.dirname(os.path.abspath(__file__))
+CONTEXT_PATH = os.path.join(HERE, "tennis_context.h")
+
+# Dolphin SDK base types (dolphin/types.h), ported from CP50 arm_a.M2C_TYPES; m2c output uses them and defines none.
+M2C_TYPES = ("typedef signed char s8;\ntypedef signed short s16;\ntypedef signed long s32;\ntypedef signed long long s64;\n"
+             "typedef unsigned char u8;\ntypedef unsigned short u16;\ntypedef unsigned long u32;\n"
+             "typedef unsigned long long u64;\ntypedef float f32;\ntypedef double f64;\n")
+
+_STRUCT = re.compile(r"typedef struct (\w+) \{\n(.*?)\n\} \1;", re.S)
+_CITE = re.compile(r"/\*\s*\+0x([0-9A-Fa-f]+)\b")
+_FNPTR = re.compile(r"\(\s*\*\s*(\w+)\s*\)")
+_NAME = re.compile(r"(\w+)\s*(?:\[[^\]]*\])*\s*;")
+
+
+def read_context(path=CONTEXT_PATH):
+    with open(path, encoding="utf-8") as fh:
+        return fh.read()
+
+
+def compose(text, context=None):
+    """Unit source for m2c text produced with --context: the header (prelude included) then the function."""
+    ctx = read_context() if context is None else context
+    return ctx.rstrip("\n") + "\n\n" + text
+
+
+def members(header):
+    """{struct tag: [(member name, cited offset or None), ...]} for every non-pad member, from the header text."""
+    out = {}
+    for tag, body in _STRUCT.findall(header):
+        rows = []
+        for line in body.splitlines():
+            decl = line.split("/*", 1)[0].strip()
+            if not decl.endswith(";"):
+                continue
+            m = _FNPTR.search(decl) or _NAME.search(decl)
+            if not m or m.group(1).startswith("pad_"):
+                continue
+            c = _CITE.search(line)
+            rows.append((m.group(1), int(c.group(1), 16) if c else None))
+        out[tag] = rows
+    return out
+
+
+def check_citations(header, layout):
+    """Findings ([] = clean). layout = {tag: {member name: offset}} from the compiler-side parser (m2c)."""
+    found = []
+    cited = members(header)
+    for tag, rows in sorted(cited.items()):
+        lay = layout.get(tag)
+        if lay is None:
+            found.append("UNPARSED_STRUCT: %s is in the header but not in the parsed layout" % tag)
+            continue
+        for name, off in rows:
+            if off is None:
+                found.append("UNCITED_MEMBER: %s.%s carries no `+0xNN` asm offset" % (tag, name))
+            elif lay.get(name) != off:
+                found.append("OFFSET_MISMATCH: %s.%s cites +0x%X, layout puts it at %s" % (
+                    tag, name, off, "+0x%X" % lay[name] if name in lay else "nowhere"))
+        named = {n for n, _ in rows}
+        for name in sorted(set(lay) - named):
+            if not name.startswith("pad_"):
+                found.append("UNSEEN_MEMBER: %s.%s is in the layout but no header line was read for it" % (tag, name))
+    return found
+
+
+def layout_of(path=CONTEXT_PATH, m2c_root=None):
+    """{tag: {member: offset}} as the pinned m2c lays the header out for PPC (raises m2c's DecompFailure on a
+    syntax error, which is the parse test)."""
+    from pathlib import Path
+    root = m2c_root or os.path.join(os.environ.get("KSR_DECOMP_TOOLS", r"C:\Users\User\Apps\decomp_tools"), "m2c")
+    if root not in sys.path:
+        sys.path.insert(0, root)
+    from m2c.arch_ppc import PpcArch  # noqa: E402  (pinned checkout, TOOLS.json)
+    from m2c.c_types import build_typemap  # noqa: E402
+    tm = build_typemap([Path(path)], PpcArch(), use_cache=False)
+    return {k: {f.name: off for off, fs in v.fields.items() for f in fs}
+            for k, v in tm.structs.items() if isinstance(k, str)}
+
+
+def main(argv):
+    if argv[1:] != ["check"]:
+        print(__doc__)
+        return 2
+    found = check_citations(read_context(), layout_of())
+    for f in found:
+        print("TENNIS_CONTEXT_BAD", f)
+    if not found:
+        print("TENNIS_CONTEXT_OK members=%d" % sum(len(r) for r in members(read_context()).values()))
+    return 1 if found else 0
+
+
+if __name__ == "__main__":
+    sys.exit(main(sys.argv))
diff --git a/tools/wros/binary/decomp/gex44/test_tennis_context.py b/tools/wros/binary/decomp/gex44/test_tennis_context.py
new file mode 100644
index 0000000..c3daaec
--- /dev/null
+++ b/tools/wros/binary/decomp/gex44/test_tennis_context.py
@@ -0,0 +1,100 @@
+"""Drills for tennis_context (WU-W11): the header parses with the pinned m2c, every struct member's cited asm offset
+equals m2c's layout (red: a wrong and a missing citation are refused), the prelude is carried exactly once, the 12
+W5a functions are declared, and m2c --context really consumes the header (red pole: without it the field is unk).
+
+    <venv>/python test_tennis_context.py      -> TENNIS_CONTEXT_DRILL=n/n
+"""
+import contextlib
+import io
+import os
+import sys
+import tempfile
+
+HERE = os.path.dirname(os.path.abspath(__file__))
+sys.path.insert(0, HERE)
+sys.path.insert(0, os.path.dirname(HERE))
+import tennis_context as T  # noqa: E402
+import m2c_producer as M  # noqa: E402
+
+passes, fails = 0, 0
+W5A = ("fn_8022F90C fn_80203FEC fn_8020711C fn_8021EAA8 fn_8020CC14 fn_80241018 "
+       "fn_801BD194 fn_80257978 fn_8025C600 fn_8022621C fn_80254440 fn_80252F34").split()
+BLOCK = (".fn fn_8020711C, global\n"
+         "/* 8020711C 00000000  80 63 00 1C */\tlwz r3, 0x1c(r3)\n"
+         "/* 80207120 00000004  38 03 FF FE */\tsubi r0, r3, 0x2\n"
+         "/* 80207124 00000008  7C 00 00 34 */\tcntlzw r0, r0\n"
+         "/* 80207128 0000000C  54 03 D9 7E */\tsrwi r3, r0, 5\n"
+         "/* 8020712C 00000010  4E 80 00 20 */\tblr\n"
+         ".endfn fn_8020711C\n")
+
+
+def gate(name, ok, evidence):
+    global passes, fails
+    print("%s %s  %s" % ("PASS" if ok else "FAIL", name, evidence))
+    passes += ok
+    fails += not ok
+
+
+def m2c_text(asm, context):
+    sys.path.insert(0, M.M2C)
+    from m2c.main import parse_flags, run  # noqa: E402  (pinned checkout)
+    with tempfile.TemporaryDirectory() as tmp:
+        src = os.path.join(tmp, "fn.s")
+        open(src, "w", encoding="utf-8").write(asm)
+        out = io.StringIO()
+        with contextlib.redirect_stdout(out), contextlib.redirect_stderr(io.StringIO()):
+            run(parse_flags(M.build_flags(False, context) + [src]))
+        return out.getvalue()
+
+
+def layout_text(text):
+    with tempfile.TemporaryDirectory() as tmp:
+        p = os.path.join(tmp, "ctx.h")
+        open(p, "w", encoding="utf-8").write(text)
+        return T.layout_of(p, M.M2C)
+
+
+def main() -> int:
+    hdr = T.read_context()
+    lay = T.layout_of(T.CONTEXT_PATH, M.M2C)
+    mem = T.members(hdr)
+    gate("V-TCTX-PARSES", len(lay) == len(mem) and len(lay) >= 12, "m2c laid out %d structs, header has %d" % (len(lay), len(mem)))
+    n = sum(len(r) for r in mem.values())
+    k = sum(1 for v in lay.values() for name in v if not name.startswith("pad_"))
+    gate("V-TCTX-MEMBERS-READ", n == k and n > 0, "header reader %d members == m2c layout %d non-pad members" % (n, k))
+    found = T.check_citations(hdr, lay)
+    gate("V-TCTX-CITATIONS-MATCH-LAYOUT", found == [], found or "every member at its cited offset")
+
+    wrong = hdr.replace("s32 f_1C; /* +0x1C", "s32 f_1C; /* +0x18", 1)
+    f = T.check_citations(wrong, layout_text(wrong))
+    gate("V-TCTX-RED-WRONG-OFFSET", wrong != hdr and any(x.startswith("OFFSET_MISMATCH: Obj8020711C.f_1C") for x in f), f)
+    bare = hdr.replace("s32 f_1C; /* +0x1C lwz r3,0x1c(r3) */", "s32 f_1C;", 1)
+    f = T.check_citations(bare, layout_text(bare))
+    gate("V-TCTX-RED-UNCITED", bare != hdr and any(x.startswith("UNCITED_MEMBER: Obj8020711C.f_1C") for x in f), f)
+    try:
+        layout_text(hdr.replace("} Obj8020711C;", "} Obj8020711C", 1))
+        gate("V-TCTX-RED-SYNTAX", False, "broken header parsed")
+    except Exception as e:  # m2c DecompFailure: the parse gate is m2c's own
+        gate("V-TCTX-RED-SYNTAX", "Syntax error" in str(e), str(e).splitlines()[0][:80])
+
+    once = all(hdr.count(l) == 1 for l in T.M2C_TYPES.splitlines()) and T.M2C_TYPES in hdr
+    unit = T.compose("s32 f(void) { return 0; }\n")
+    gate("V-TCTX-PRELUDE-ONCE", once and unit.count("typedef signed long s32;") == 1 and unit.endswith("return 0; }\n"),
+         "prelude in header and in a composed unit exactly once")
+
+    sys.path.insert(0, M.M2C)
+    from pathlib import Path
+    from m2c.arch_ppc import PpcArch
+    from m2c.c_types import build_typemap
+    fns = build_typemap([Path(T.CONTEXT_PATH)], PpcArch(), use_cache=False).functions
+    gate("V-TCTX-W5A-DECLARED", all(x in fns for x in W5A), [x for x in W5A if x not in fns] or "12/12 prototypes")
+
+    with_ctx, without = m2c_text(BLOCK, T.CONTEXT_PATH), m2c_text(BLOCK, None)
+    gate("V-TCTX-M2C-CONSUMES-CONTEXT", "arg0->f_1C" in with_ctx and "unk" not in with_ctx and "unk1C" in without,
+         {"with": with_ctx.strip().splitlines()[-2:], "without_has_unk1C": "unk1C" in without})
+    print("TENNIS_CONTEXT_DRILL=%d/%d" % (passes, passes + fails))
+    return 0 if fails == 0 else 1
+
+
+if __name__ == "__main__":
+    sys.exit(main())
