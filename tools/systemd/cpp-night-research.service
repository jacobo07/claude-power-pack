[Unit]
Description=CPP night research: one gated pass (tools/night_research_runner.py)
# The runner refuses off the VPS and the vendored gate refuses outside the night window,
# while paused, or past the per-night budget -- a fire at the wrong time writes nothing.

[Service]
Type=oneshot
WorkingDirectory=%h/pp-night
ExecStart=/usr/bin/python3 %h/pp-night/tools/night_research_runner.py run
Environment=CPP_NIGHT_NODE=%h/.local/node24/bin/node
TimeoutStartSec=300
Nice=10
